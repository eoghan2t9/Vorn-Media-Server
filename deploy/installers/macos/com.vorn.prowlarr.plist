<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.vorn.prowlarr</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/prowlarr/Prowlarr</string>
        <string>-nobrowser</string>
        <string>-data=/usr/local/var/prowlarr</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/usr/local/var/log/prowlarr.log</string>
    <key>StandardErrorPath</key>
    <string>/usr/local/var/log/prowlarr.log</string>
</dict>
</plist>
